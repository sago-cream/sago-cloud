[Unit]
Description=Deploy one owner-authorized MiniSago commit
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/
Environment=OPERATIONS_ROOT=/srv/sago-cloud/operations
Environment=STATE_ROOT=/srv/sago-cloud/state
ExecStart=/usr/local/libexec/sago-cloud-minisago-deploy
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=20min
