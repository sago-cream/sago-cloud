{$DOMAIN} {
	encode zstd gzip
	log

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	@internal path /api/internal/* /bot/api/internal/*
	respond @internal 404

	redir /bot /bot/ 308

	handle_path /bot/* {
		reverse_proxy bot-core:3000
	}

	handle {
		reverse_proxy bot-core:3000
	}
}

http://{$NO5_DOMAIN} {
	encode zstd gzip
	log

	header {
		Cache-Control "private, no-store"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}

	@allowed client_ip {$NO5_ALLOWED_IP}

	handle @allowed {
		root * /srv/no-5
		try_files {path} /index.html
		file_server
	}

	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "This private site is only available from the No.5 home network." 403
	}
}

http://{$MEDIA_DOMAIN} {
	log

	header {
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		-Server
	}

	@media_api path /v1/* /activate /auth/* /admin /admin/*

	handle @media_api {
		request_body {
			max_size 95000000
		}

		header {
			Cache-Control no-store
		}

		reverse_proxy pr-media-api:3000
	}

	@supported_media path_regexp supported_media ^/[0-9a-f]{2}/[0-9a-f]{64}\.(?:gif|jpeg|jpg|mp4|png|webm|webp)$

	handle @supported_media {
		header {
			Access-Control-Allow-Origin *
			Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"
			Cross-Origin-Resource-Policy cross-origin
		}

		root * /srv/pr-media
		file_server
	}

	respond 404
}

