#!/usr/bin/env bash
set -euo pipefail

if docker info >/dev/null 2>&1; then DOCKER=(docker); else DOCKER=(sudo -n docker); fi

retention="${DOCKER_IMAGE_RETENTION:-720h}"
if [[ ! "$retention" =~ ^[1-9][0-9]*h$ ]]; then
  printf 'DOCKER_IMAGE_RETENTION must be a positive number of hours.\n' >&2
  exit 1
fi

"${DOCKER[@]}" image prune --all --force --filter "until=$retention"
"${DOCKER[@]}" builder prune --force --filter "until=$retention"
