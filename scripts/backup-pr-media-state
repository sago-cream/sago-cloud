#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -eq 0 ]; then
  SUDO=()
else
  SUDO=(sudo -n)
fi

operations_root="${OPERATIONS_ROOT:-/srv/sago-cloud/operations}"
backups_root="${BACKUPS_ROOT:-/srv/sago-cloud/backups}"
compose_file="$operations_root/services/media-api/compose.yaml"
DOCKER=("${SUDO[@]}" docker)
backup_dir="$backups_root/pr-media"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
destination="$backup_dir/media-$timestamp.sqlite"
temporary="$(mktemp "${TMPDIR:-/tmp}/sago-media-state.XXXXXX")"
trap 'rm -f -- "$temporary"' EXIT

"${SUDO[@]}" install -d -o root -g root -m 0700 "$backup_dir"
"${DOCKER[@]}" compose -f "$compose_file" exec -T api bun -e \
  'import { Database } from "bun:sqlite"; const db = new Database("/srv/pr-media/.service/media.sqlite", { readonly: true }); process.stdout.write(Buffer.from(db.serialize()));' \
  >"$temporary"

"${DOCKER[@]}" compose -f "$compose_file" exec -T api bun -e \
  'import { Database } from "bun:sqlite"; import { unlink } from "node:fs/promises"; const path = `/tmp/media-backup-${crypto.randomUUID()}.sqlite`; try { const bytes = await Bun.stdin.arrayBuffer(); await Bun.write(path, bytes); const db = new Database(path, { readonly: true }); const result = db.query("PRAGMA integrity_check").get(); if (result.integrity_check !== "ok") process.exitCode = 1; } finally { await unlink(path).catch(() => {}); }' \
  <"$temporary"

"${SUDO[@]}" install -o root -g root -m 0600 "$temporary" "$destination"
"${SUDO[@]}" find "$backup_dir" -type f -name 'media-*.sqlite' -mtime +30 -delete
printf '%s\n' "$destination"
