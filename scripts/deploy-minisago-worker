#!/usr/bin/env bash
set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

apparmor_profile="$OPERATIONS_ROOT/services/minisago-worker/minisago-worker.apparmor"
sudo -n install -m 0644 "$apparmor_profile" /etc/apparmor.d/minisago-worker
sudo -n apparmor_parser -r /etc/apparmor.d/minisago-worker
sudo -n install -d -m 0700 /var/lib/minisago-sandbox

require_media_mount
compose_pull minisago-worker
compose_up minisago-worker
