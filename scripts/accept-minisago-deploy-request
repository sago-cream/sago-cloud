#!/usr/bin/env bash
set -euo pipefail
umask 077

OPERATIONS_ROOT="${OPERATIONS_ROOT:-/srv/sago-cloud/operations}"
STATE_ROOT="${STATE_ROOT:-/srv/sago-cloud/state}"
flock_command="${MINISAGO_DEPLOY_FLOCK_COMMAND:-flock}"
state_dir="$STATE_ROOT/minisago-deploy"

# The optional channel is accepted only for clients predating the T3 relay.
read -r command commit channel_id extra || true
if [[ ! "$commit" =~ ^[0-9a-f]{40}$ || -n "${extra:-}" ||
      ( "$command" != deploy && "$command" != status ) ||
      ( -n "${channel_id:-}" && ( "$command" != deploy || ! "$channel_id" =~ ^[0-9]{17,20}$ ) ) ]]; then
  printf 'denied invalid-request\n'
  exit 64
fi

if [[ "$command" == status ]]; then
  if [[ -f "$state_dir/$commit.json" ]]; then
    cat "$state_dir/$commit.json"
  else
    printf 'unknown %s\n' "$commit"
  fi
  exit 0
fi

mkdir -p "$state_dir"
exec 9>"$state_dir/lock"
if ! "$flock_command" -n 9; then
  printf 'busy deployment-in-progress\n'
  exit 75
fi

# Recheck on the host: callers cannot deploy an unmerged branch or mutable tag.
if ! main="$(timeout 5 git ls-remote --exit-code https://github.com/sago-cream/mini-sago.git refs/heads/main)"; then
  printf 'denied origin-main-unavailable\n'
  exit 69
fi
if [[ "${main%%[[:space:]]*}" != "$commit" ]]; then
  printf 'denied commit-is-not-origin-main\n'
  exit 65
fi

write_status() {
  local status="$1" exit_code="${2:-null}" temporary
  temporary="$(mktemp "$state_dir/.status.XXXXXX")"
  printf '{"commit":"%s","status":"%s","exitCode":%s,"updatedAt":"%s"' \
    "$commit" "$status" "$exit_code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$temporary"
  if [[ -n "${channel_id:-}" ]]; then
    printf ',"channelId":"%s"' "$channel_id" >>"$temporary"
  fi
  printf '}\n' >>"$temporary"
  chmod 0644 "$temporary"
  mv -f -- "$temporary" "$state_dir/$commit.json"
  # During migration an older bot can still report results for its old clients.
  cp "$state_dir/$commit.json" "$state_dir/latest.json"
}

write_status queued
printf 'accepted %s\n' "$commit"
exec </dev/null
exec >>"$state_dir/$commit.log" 2>&1
failed() {
  local exit_code="$?"
  write_status failed "$exit_code"
  exit "$exit_code"
}
trap failed ERR

write_status waiting_images
"$OPERATIONS_ROOT/scripts/wait-minisago-images" "$commit"
write_status running
image_tag="sha-$commit"
BOT_CORE_IMAGE_TAG="$image_tag" \
MINISAGO_WORKER_IMAGE_TAG="$image_tag" \
MINISAGO_IMAGES_PREPULLED=1 \
  "$OPERATIONS_ROOT/scripts/deploy-minisago"
trap - ERR
write_status complete 0
