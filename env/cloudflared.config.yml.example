# Generated by scripts/generate-routing.mjs; edit config/routes.mjs.
tunnel: <tunnel-id>
credentials-file: /etc/cloudflared/credentials.json

ingress:
  - hostname: <homepage-hostname>
    service: https://edge:443
    originRequest:
      originServerName: <homepage-hostname>
  - hostname: <bot-hostname>
    service: https://edge:443
    originRequest:
      originServerName: <bot-hostname>
  - hostname: <no5-hostname>
    service: http://edge:80
  - hostname: <media-hostname>
    service: http://edge:80
  - hostname: <legacy-media-hostname>
    service: http://edge:80
  - service: http_status:404
