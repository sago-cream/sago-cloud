#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
compose="$repo_root/services/sago-media-api/compose.yaml"
caddyfile="$repo_root/edge/Caddyfile"
installer="$repo_root/scripts/install-sago-media-storage"
deployer="$repo_root/scripts/deploy-sago-media-api"
maintenance="$repo_root/scripts/run-sago-media-maintenance"
backup="$repo_root/scripts/backup-sago-media-state"
worker_compose="$repo_root/services/minisago-worker/compose.yaml"

grep -Fq 'image: ${MEDIA_IMAGE:-ghcr.io/sago-cream/sago-media:v2.0.0}' "$compose"
grep -Fq 'read_only: true' "$compose"
grep -Fq 'user: "10001:10001"' "$compose"
grep -Fq -- '- ALL' "$compose"
grep -Fq 'no-new-privileges:true' "$compose"
grep -Fq '/srv/sago-media:/srv/sago-media' "$compose"
grep -Fq 'reverse_proxy sago-media-api:3000' "$caddyfile"
grep -Fq '@media_api path /v1/* /activate /auth/* /admin /admin/*' "$caddyfile"
grep -Fq 'Cache-Control no-store' "$caddyfile"
grep -Fq 'max_size 95000000' "$caddyfile"
grep -Fq 'gif|jpeg|jpg|mp4|png|webm|webp' "$caddyfile"
grep -Fq 'run-sago-media-maintenance' "$installer"
grep -Fq 'chown -R 10001:10001' "$installer"
grep -Fq 'compose_pull sago-media-api' "$deployer"
grep -Fq 'MEDIA_GITHUB_CLIENT_SECRET' "$deployer"
grep -Fq 'MEDIA_ACCESS_NOTIFICATION_SECRET' "$deployer"
grep -Fq 'MEDIA_ACCESS_NOTIFICATION_URL=http://bot-core:3000/api/internal/media-access-request' "$deployer"
grep -Fq 'Media access notifications must use the private bot-core endpoint.' "$deployer"
grep -Fq 'Media public URLs must use HTTPS' "$deployer"
grep -Fq 'systemctl enable --now' "$deployer"
grep -Fq 'docker compose' "$maintenance"
grep -Fq 'exec -T api "$command"' "$maintenance"
grep -Fq 'db.serialize()' "$backup"
grep -Fq 'PRAGMA integrity_check' "$backup"
grep -Fq 'await Bun.write(path, bytes)' "$backup"
grep -Fq 'sago-cloud-media-backup.timer' "$deployer"
grep -Fq 'sago-cloud-media-backup.timer' "$installer"

if grep -Eq '(^|[[:space:]])(build|ports):' "$compose"; then
  printf 'Media deployment must pull an image and publish no host ports\n' >&2
  exit 1
fi

if [ -e "$repo_root/services/sago-media-api/server.ts" ] ||
  [ -e "$repo_root/services/sago-media-api/Dockerfile" ]; then
  printf 'Media application source must not live in sago-cloud\n' >&2
  exit 1
fi

if find "$repo_root/scripts" -maxdepth 1 -type f \
  \( -name 'sago-media-upload' -o -name 'sago-media-optimize' -o \
  -name 'sago-media-pin' -o -name 'sago-media-prune' -o \
  -name 'sago-media-verify' -o -name 'sago-media-token' \) | grep -q .; then
  printf 'Media product commands must not live in sago-cloud\n' >&2
  exit 1
fi

if grep -Fq '/srv/sago-media' "$worker_compose"; then
  printf 'The Codex worker must use the media API instead of host storage\n' >&2
  exit 1
fi

printf 'Media deployment contains only image, storage, routing, and scheduling infrastructure\n'
