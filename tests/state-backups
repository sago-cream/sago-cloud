#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup="$repo_root/scripts/backup-state-volumes"
verify="$repo_root/scripts/verify-state-backups"

grep -Fq 'compose "$stack" stop' "$backup"
grep -Fq 'OPERATIONS_ROOT="${OPERATIONS_ROOT:-/srv/sago-cloud/operations}"' "$backup"
grep -Fq 'sago_cloud_bot-core-state' "$backup"
grep -Fq 'sago_cloud_obi-data' "$backup"
grep -Fq 'SAGO_CLOUD_RESTORE_CONFIRMED=yes' "$verify"
grep -Fq 'http://127.0.0.1:5984/_all_dbs' "$verify"
grep -Fq 'PRAGMA integrity_check' "$verify"

printf 'State backups are consistent and restore-tested\n'
